{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor MotorLeft = motor(PORT1, false);\nmotor MotorRight = motor(PORT6, true);\nbumper Bumper2 = bumper(PORT2);\ntouchled TouchLED12 = touchled(PORT12);\ncontroller Controller = controller();\nmotor MotorConveyorLeft = motor(PORT3, true);\nmotor MotorConveyorRight = motor(PORT4, false);\ndistance Distance5 = distance(PORT5);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\nvoid configureAllSensors()\n{\n  BrainInertial.calibrate();\n  wait(2,seconds);\n  BrainInertial.setHeading(0,degrees);\n  BrainInertial.setRotation(0,degrees);\n  MotorLeft.setPosition(0,turns);\n  MotorRight.setPosition(0,turns);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setFont(mono15);\n}\n\n//rotate robot to a certain angle at a given power\nvoid rotateRobot (int angle, int motorPower){\n  BrainInertial.setRotation(0,degrees);\n  wait(50, msec);\n\n  MotorLeft.setVelocity(motorPower,percent);\n  MotorRight.setVelocity(motorPower,percent);\n  //for positive angle, rotates clockwise\n  if (angle>0) {\n    MotorLeft.spin(forward);\n    MotorRight.spin(reverse); \n  }\n  //for negative angle, rotates counterclockwise\n  else {\n    MotorLeft.spin(reverse);\n    MotorRight.spin(forward);\n  }\n  while (abs(BrainInertial.rotation(degrees))<abs(angle)) {\n  }\n  MotorLeft.stop();\n  MotorRight.stop();\n}\n\nfloat alignTable(float & rotationChange)\n{\n  //Brain.Screen.print(\"align\");\n  float addToPosition = MotorRight.position(turns);\n  float distanceTol = 10; // Change after experimentation\n\n  MotorLeft.setVelocity(30, percent);\n  MotorRight.setVelocity(30, percent);\n  MotorLeft.spin(forward);\n  MotorRight.spin(forward);\n\n  // Keep moving forward while the bumper is not pressed and the distance sensor isn't close\n  Brain.Screen.newLine();\n  Brain.Screen.print (\"ATP: %f\", addToPosition);\n  float rotationInitial = BrainInertial.heading(degrees);\n  while (!Bumper2.pressing() && !(Distance5.objectDistance(mm) < distanceTol)){}\n  MotorLeft.stop();\n  MotorRight.stop();\n  addToPosition =(MotorRight.position(turns) - addToPosition) *200.0;\n  Brain.Screen.newLine();\n  Brain.Screen.print(\"ATP: %f\", addToPosition);\n\n  //currentCoords [1] = currentCoords [1]+ addToPosition;\n  \n  // If the bumper is pressed first, the opposite side's wheel moves forward until the  distance sensor distance ~ 0\n  if (Bumper2.pressing())\n  {\n    Brain.Screen.newLine();\n    //Brain.Screen.print(\"bumper\");\n    MotorRight.spin(forward);\n    while (Distance5.objectDistance(mm) > distanceTol){} \n    MotorRight.stop();\n  }\n    \n  // If the distance sensor ~ 0 first, the opposite side's wheel moves forward until the bumper is pressed.\n  else if (Distance5.objectDistance(mm) < distanceTol)\n  {\n    Brain.Screen.newLine();\n    //Brain.Screen.print(\"distance\");\n    MotorLeft.spin(forward);\n    while (!Bumper2.pressing()){}\n    MotorLeft.stop();\n  }\n  float rotationFinal = BrainInertial.heading(degrees);\n  rotationChange = rotationFinal - rotationInitial;\n  Brain.Screen.newLine();\n  Brain.Screen.print(\"rot Chan %f\", rotationChange);\n  return addToPosition;\n}\n\nint controllerUsage()\n{\n  int buttonPressed = 0;\n  // Waits until a button is pressed\n  while (!(Controller.ButtonEDown.pressing()) && !(Controller.ButtonEUp.pressing()) && !(Controller.ButtonFDown.pressing()) && !(Controller.ButtonFUp.pressing())){}\n  // E up = table 1, E down = table 2, F up = table 3\n  // Stores what button is being pressed\n  if (Controller.ButtonEDown.pressing())\n  {\n    buttonPressed = 1;\n  }\n  else if (Controller.ButtonEUp.pressing())\n  {\n    buttonPressed = 0;\n  }\n  else if (Controller.ButtonFUp.pressing())\n  {\n    buttonPressed = 2;\n  }\n  else if (Controller.ButtonFDown.pressing())\n  {\n    buttonPressed = -1;\n  }\n  // Waits until the button is done being pressed\n  //while (Controller.ButtonEDown.pressing() || Controller.ButtonEUp.pressing()|| Controller.ButtonFDown.pressing() || Controller.ButtonFUp.pressing()){}\n  return buttonPressed;\n\n}\n\n\nvoid obstacleDetection(float rotations) \n{\n  //Brain.Screen.print(\"object detection function\");\n  float objectTol = 150.00; // Arbitrary # of how close something has to be to be considered an obstacle\n  float rotationsTol = rotations - (360)*0.5; // Basically making sure the obstacle isn't actually the table \n                                          // (in this case, it needs to be more than 5 turns away from the table)\n\n  // \"If the distance sensor detects something equal or closer to it than the tolerance and the robot is far enough from the table\"\n  if ( (Distance5.objectDistance(mm) <= objectTol) && (MotorLeft.position(degrees) < rotationsTol) )\n  {\n    MotorLeft.setVelocity(0, percent);\n    MotorRight.setVelocity(0, percent);\n    while(Distance5.objectDistance(mm) <= objectTol){} // waiting until object leaves\n    MotorLeft.setVelocity(70, percent);\n    MotorRight.setVelocity(70, percent);\n  }\n\n}\n\nvoid moveForward(float distance, int direction)\n{\n  MotorLeft.setPosition(0, degrees);\n  MotorLeft.setVelocity(50, percent);\n  MotorRight.setVelocity(50, percent);\n\n  if (direction == 1)\n  {\n    MotorLeft.spin(reverse);\n    MotorRight.spin(reverse);\n  }\n  else\n  {\n    MotorLeft.spin(forward);\n    MotorRight.spin(forward);\n  }\n  \n  while (MotorLeft.position(degrees) < ((distance/200.00)*360))\n  {\n    obstacleDetection((distance/200.00)*360);\n    //wait(2, seconds); // check for obstacles every 2 seconds\n  }\n  MotorLeft.stop();\n  MotorRight.stop();\n}\n\nint feedback ( )\n{\n  float time = Brain.Timer.value();\n  Brain.Screen.newLine();\n  Brain.Screen.print(\"It took %f\", time, \"seconds to deliver the food\");\n  Brain.Screen.newLine();\n  Brain.Screen.print(\"Your feedback would be greatly appreciated!\");\n  Brain.Screen.newLine();\n  int rating = -1;\n  while (rating == -1)\n  {\n    while(!TouchLED12.pressing()) {}\n    //Brain.Timer.reset();\n    timer feedbackTimer;\n    feedbackTimer.reset();\n    while (TouchLED12.pressing())\n    {\n    }\n    double secondsPressed = feedbackTimer.value();\n    if (secondsPressed < 2.00)\n    {\n      rating = 3;\n    }\n    else if (secondsPressed < 5.00)\n    {\n      rating = 2;\n    }\n    else if (secondsPressed < 10.00)\n    {\n      rating = 1;\n    }\n    Brain.Screen.newLine();\n    Brain.Screen.print(\"You have given us %d\", rating, \"stars out of 3! If you want to change your rating please tap the touch LED\");\n    //Brain.Screen.newLine();\n    double resetRating = Brain.Timer.value();\n    /*while (Brain.Timer.value() < resetRating + 5000)\n    {\n      if (TouchLED12.pressing())\n      {\n        rating = -1;\n        Brain.Screen.print(\"Please renter the feedback\");\n        Brain.Screen.newLine();\n      }\n    }\n    */\n  }\n  return rating;\n}\n\nvoid unload(double distance, double CIRCUMFERENCE) // Motors are reverse\n{\n  double turn = distance/CIRCUMFERENCE + 0.1; // Experimental value should be used\n  MotorConveyorLeft.setVelocity(30, percent);\n  MotorConveyorRight.setVelocity(30, percent);\n  MotorConveyorLeft.setPosition(0, degrees);\n  MotorConveyorLeft.spin(forward);\n  MotorConveyorRight.spin(forward);\n  while (MotorConveyorLeft.position(degrees) < (turn*360.0)){}\n  /*\n  MotorConveyorLeft.spinFor(forward, turn, turns);\n  MotorConveyorRight.spinFor(forward, turn, turns);\n  */\n  MotorConveyorRight.stop(coast);\n  MotorConveyorLeft.stop(coast);\n}\n\nint main() \n{\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n  configureAllSensors();\n\n  float tableCoords[3][2] = {{2500, 0}, {2000, -2000}, {0, -2000}}; // Coordinates in mm, each row represents a table\n  float avgCount = 0;\n  float deliveryTimeAvg = 0;\n  float feedbackAvg = 0;\n\n  while(!Controller.ButtonFDown.pressing())\n  {\n    Brain.Timer.reset();\n    float currentCoords[3] = {0,0,0};\n    float rotationChange = 0.0;\n\n    int table = controllerUsage();\n    if (!(table == -1))\n    {\n      rotationChange = 0.0;\n      // Move forward x cm and reset robot's current coords\n      currentCoords[0] = tableCoords[table] [0];\n\n      if (tableCoords [table][0]>0.0)\n      {\n        moveForward(abs(tableCoords[table][0]), 0);\n      }\n      else if (tableCoords [table] [0] <0.0)\n      {\n        rotateRobot (180,10);\n        currentCoords [2] = currentCoords [2] + 180;\n        moveForward(abs(tableCoords[table][0]), 0);\n      }\n\n      float printTest = 0;\n\n      // If it hasn't reach the right y coordinate, turn 90 degrees\n      if(currentCoords[1] != tableCoords[table][1])\n      {\n        if ((tableCoords [table] [1] < 0.0 && tableCoords [table] [0] > 0.0)|| (tableCoords [table] [1] >0.0 && tableCoords [table] [0]<0.0))\n        {\n          rotateRobot(85, 10);\n          currentCoords[2] += 85;\n        }\n        else \n        {\n          rotateRobot(-85, 10);\n          currentCoords[2] += -85;\n        }\n        printTest = currentCoords [2];\n        //Brain.Screen.newLine();\n        //Brain.Screen.print(\"toTableRot %f\", printTest);\n      }\n      // Move forward y cm\n      moveForward(abs(tableCoords[table][1]), 0);\n      currentCoords [1] = tableCoords [table] [1];\n\n      // At the table\n      float positionAdd = alignTable(rotationChange);\n      printTest = positionAdd;\n      Brain.Screen.newLine();\n      Brain.Screen.print(\"posAdd %f\", positionAdd);\n      //currentCoords[2] += rotationChange;\n      if (currentCoords [1] > 0.0)\n      {\n        currentCoords [1] = currentCoords [1] + positionAdd;\n      }\n      else if (currentCoords [1]< 0.0){\n        currentCoords [1] = currentCoords [1] - positionAdd;\n      } \n      else \n      {\n        currentCoords [0] = currentCoords [0] + (currentCoords [0]/(abs(currentCoords[0])))*positionAdd;\n      }\n\n      printTest = currentCoords [0];\n\n      //Brain.Screen.newLine();\n      //Brain.Screen.print(\"currCoor %f\", printTest);\n      unload(600.0, 200.0);\n      Brain.playSound(tada);\n    \n      feedbackAvg += feedback();\n      \n      // Going back to kitchen\n      rotateRobot(-rotationChange, 10);\n      MotorLeft.setPosition(2, turns);\n      double position = MotorLeft.position(turns);\n      MotorLeft.setVelocity(50, percent);\n      MotorRight.setVelocity(50, percent);\n      MotorLeft.spin(reverse);\n      MotorRight.spin(reverse);\n\n      while(MotorLeft.position(turns) > 0)\n      {\n      }\n      MotorLeft.stop();\n      MotorRight.stop();\n      if (tableCoords [table] [1] == 0)\n      {\n        if (tableCoords [table] [0] < 0)\n        {\n          currentCoords [0] = currentCoords[0] + 400.0; \n        }\n        else \n        {\n          currentCoords [0] = currentCoords [0] - 400.0;\n        }\n      }\n      else \n      {\n        if (tableCoords [table] [1] < 0)\n        {\n          currentCoords [1] = currentCoords[1] + 400.0; \n        }\n        else \n        {\n          currentCoords [1] = currentCoords [1] - 400.0;\n        }\n      }\n      printTest = currentCoords [0];\n      Brain.Screen.newLine();\n      Brain.Screen.print(\"currCoor %f\", printTest);\n      rotateRobot(178, 10);\n      if (tableCoords [table] [1] <0)\n      {\n        currentCoords[2] += -178;\n      }\n      else if (tableCoords [table][1] >=0)\n      {\n        currentCoords[2] += 178;\n      }\n\n      printTest = currentCoords [2];\n\n      //Brain.Screen.newLine();\n      //Brain.Screen.print(\"180 rot: %f\", printTest);\n\n      // Move back in same y amount, then x amount\n      float tablecoorx = tableCoords[table] [0];\n      float tablecoory = tableCoords [table] [1];\n      //Brain.Screen.newLine();\n      //Brain.Screen.print(\"the coords are %f\", tablecoory, \" %f\", tablecoorx);\n\n      moveForward(abs(tablecoory), 0);\n\n      if ((tableCoords [table] [1] < 0.0 && tableCoords [table] [0] > 0.0)|| (tableCoords [table] [1] >0.0 && tableCoords [table] [0]<0.0) && tablecoory != 0)\n      {\n        rotateRobot(-85, 10);\n        currentCoords[2] += -85;\n        printTest = currentCoords [2];\n        //Brain.Screen.newLine();\n        //Brain.Screen.print(\"coory rot: %f\", printTest);\n      }\n\n      else if ((tableCoords [table] [1] < 0.0 && tableCoords [table] [0] < 0.0)|| (tableCoords [table] [1] >0.0 && tableCoords [table] [0]>0.0) && tablecoory !=0)\n      {\n        rotateRobot(85, 10);\n        currentCoords [2] += 85;\n        printTest = currentCoords [2];\n        //Brain.Screen.newLine();\n        //Brain.Screen.print(\"coory rot: %f\", printTest);\n      }\n    \n      currentCoords[1] = 0;\n\n      // If it hasn't reach the right y coordinate, turn 90 degrees\n      //double coordinatex = tableCoords [table] [0];\n      //Brain.Screen.newLine();\n      //Brain.Screen.print(\"your location is %d\", coordinatex);\n\n      printTest = currentCoords [0];\n\n      Brain.Screen.newLine();\n      Brain.Screen.print(\"curCoor: %f\", printTest);\n\n      moveForward(abs(currentCoords [0]),0); // changed here\n\n      deliveryTimeAvg += Brain.Timer.value();\n      avgCount ++;\n\n      float rotateKitchen = -1*currentCoords[2];\n      //Brain.Screen.newLine();\n      //Brain.Screen.print(\"rotation: %f\", rotateKitchen);\n      rotateRobot(rotateKitchen, 10);\n\n    }\n  }\n\n  deliveryTimeAvg = deliveryTimeAvg/avgCount;\n  feedbackAvg = feedbackAvg/avgCount;\n  Brain.Screen.setCursor(2, 1);\n  Brain.Screen.newLine();\n  Brain.Screen.print(\"Delivery Time Avg: %f\", deliveryTimeAvg);\n  //Brain.Screen.setCursor(4, 1); // Could add back\n  Brain.Screen.newLine(); // can take out\n  Brain.Screen.print(\"Rating avg: %f\", feedbackAvg);\n  wait(10, seconds);\n\n  \n  Brain.programStop();\n}","textLanguage":"cpp","robotConfig":[],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.62.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}